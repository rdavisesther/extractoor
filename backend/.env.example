# Server
PORT=4000
NODE_ENV=development

# CORS - comma separated origins, or * for all
CORS_ORIGIN=*

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# SQLite database file
DATABASE_PATH=./data/subdomain-generator.db

# Worker thread pool size (0 = auto = cpu count)
WORKER_POOL_SIZE=0

# Max subdomains allowed per single request
MAX_SUBDOMAINS=1000000

# Keep this secret in production
# CRYPTO_SECRET=change-me
