# Server (local runtime only; Vercel sets these via the dashboard)
PORT=4000
NODE_ENV=development

# CORS - comma separated origins, or * for all.
# For Vercel, set to your frontend URL (e.g. https://your-app.vercel.app) or keep *.
CORS_ORIGIN=*

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Stricter limit for extraction endpoints (per window per IP)
EXTRACTION_RATE_LIMIT_MAX=10

# Maximum emails per single extraction request
MAX_EXTRACTION_COUNT=1000

# Maximum concurrent extractions across all clients
MAX_CONCURRENT_EXTRACTIONS=5
