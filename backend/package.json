{
  "name": "subdomain-generator-api",
  "version": "1.0.0",
  "description": "High-performance bulk subdomain generator REST API with worker-thread parallelism, SQLite persistence, and a 20,000+ prefix dictionary.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:prod": "npm run build && node dist/server.js",
    "lint": "eslint \"src/**/*.ts\" \"api/**/*.ts\" \"tests/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\" \"api/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"api/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:serverless": "tsc --noEmit -p tsconfig.serverless.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dictionary": "tsx scripts/generate-dictionary.ts"
  },
  "keywords": [
    "subdomain",
    "generator",
    "express",
    "worker-threads",
    "sqlite",
    "rest-api"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
