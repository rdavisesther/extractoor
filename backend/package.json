{
  "name": "mailcmh-api",
  "version": "1.0.0",
  "description": "MailCMH - Email extraction and DNS tooling dashboard API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:prod": "npm run build && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:serverless": "tsc --noEmit -p tsconfig.serverless.json"
  },
  "keywords": [
    "email",
    "imap",
    "dns",
    "extraction",
    "dashboard"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "imapflow": "^1.0.170",
    "mailparser": "^3.7.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
