# Docker Compose environment (copy to .env at the repo root before `docker compose up`)
# Allowed CORS origins for the backend. Use the full frontend origin in production.
CORS_ORIGIN=*

# Worker thread pool size (0 = auto-detect CPU count)
WORKER_POOL_SIZE=0

# PostgreSQL service (only started with: docker compose --profile postgres up)
POSTGRES_USER=subgen
POSTGRES_PASSWORD=subgen
POSTGRES_DB=subgen
