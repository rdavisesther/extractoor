# IMPORTANT (Vercel deployment):
# This must point to your DEPLOYED backend URL, e.g. https://your-backend.vercel.app
# No trailing slash.
NEXT_PUBLIC_API_URL=

# Local development only: where the Express backend runs (used by the dev proxy when
# NEXT_PUBLIC_API_URL is empty).
NEXT_PUBLIC_API_PROXY=http://localhost:4000
